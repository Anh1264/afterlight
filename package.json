{
  "name": "afterlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/art-manifest.mjs && concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "node scripts/art-manifest.mjs && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run -s typecheck && npm test",
    "sim": "tsx shared/simulate.ts",
    "ladder": "tsx scripts/ladder.ts",
    "sim:bots": "tsx scripts/ladder.ts",
    "bot-golden": "tsx scripts/bot-golden.ts",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
